{
  "hosting": {
    "site": "SITE_ID_HERE",
    "public": "public",
    "ignore": ["firebase.json", "**/.*"],
    "cleanUrls": true,
    "headers": [
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
      { "source": "/@(img|icon|lp)/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
    ]
  }
}
