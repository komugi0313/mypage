+ */
+(function(){
+  var SITE = 'https://unkiyoho.jp/';
+  var KEY = 'unkiyoho_ref', DAYS = 30;
+  var TEXT = '毎朝6時に、生年月日からわたしだけの運勢が届く「私だけの開運予報」🌤 ずっと無料だよ';
+
+  // 1) ?ref= を覚える
+  try{
+    var m = location.search.match(/[?&]ref=([A-Za-z0-9_-]{1,32})/);
+    if (m){
+      var cur = JSON.parse(localStorage.getItem(KEY) || 'null');
+      if (!cur || Date.now() - cur.at > DAYS * 864e5) localStorage.setItem(KEY, JSON.stringify({ code: m[1], at: Date.now() }));
+    }
+  }catch(e){}
+
+  function ref(){
+    try{ var r = JSON.parse(localStorage.getItem(KEY) || 'null'); return (r && Date.now() - r.at <= DAYS * 864e5) ? r.code : ''; }catch(e){ return ''; }
+  }
+  function myCode(){
+    if (window.UNKIYOHO_MY_REF) return String(window.UNKIYOHO_MY_REF);
+    try{ // 開発モード：この端末だけの仮コード（本番はサーバーの ref_code を使う）
+      var c = localStorage.getItem('unkiyoho_my_ref');
+      if (!c){ c = Math.random().toString(36).slice(2, 9); localStorage.setItem('unkiyoho_my_ref', c); }
+      return c;
+    }catch(e){ return ''; }
+  }
+  // スマホかどうか（LINEのシェアはスマホではアプリが開くが、パソコンではLINEのログイン画面になる＝LINEの仕様）
+  function isMobile(){
+    var ua = navigator.userAgent || '';
+    return /iPhone|iPad|iPod|Android|Mobile/i.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
+  }
+  function url(code){ return SITE + (code ? '?ref=' + encodeURIComponent(code) : ''); }
+
+  function mount(el, code){
+    if (!el) return;
+    var u = url(code), eu = encodeURIComponent(u), et = encodeURIComponent(TEXT);
+    var b = 'display:inline-flex;align-items:center;justify-content:center;gap:5px;min-width:120px;box-sizing:border-box;border:none;border-radius:999px;padding:11px 16px;margin:4px;font-size:13.5px;font-weight:800;text-decoration:none;cursor:pointer;font-family:inherit;';
+    var line = '<a href="https://social-plugins.line.me/lineit/share?url=' + eu + '&text=' + et + '" target="_blank" rel="noopener" style="' + b + 'background:#06c755;color:#fff;">LINEで送る</a>';
+    var x = '<a href="https://twitter.com/intent/tweet?text=' + et + '&url=' + eu + '" target="_blank" rel="noopener" style="' + b + 'background:#1d1f23;color:#fff;">𝕏 でシェア</a>';
+    var h;
+    if (isMobile()) {   // スマホ：LINE → X → コピー →（あれば）スマホの共有
+      h = line + x
+        + '<button type="button" data-copy style="' + b + 'background:#fff;color:#c14e77;border:1.5px solid #e8a8bd;">🔗 リンクをコピー</button>'
+        + (navigator.share ? '<button type="button" data-native style="' + b + 'background:#fff;color:#7a6e78;border:1.5px solid #ddd0d6;">📤 その他</button>' : '');
+    } else {            // パソコン：LINEボタンは出さず、「リンクをコピー」をいちばん目立たせる
+      h = '<button type="button" data-copy style="' + b + 'background:#c14e77;color:#fff;">🔗 リンクをコピー</button>' + x
+        + '<div style="font-size:11.5px;color:#9a8d94;margin-top:6px;">コピーしたリンクを、LINEやメールに貼り付けて送ってね</div>';
+    }
+    el.innerHTML = h;
+    var cp = el.querySelector('[data-copy]');
+    if (cp) cp.onclick = function(){
+      var done = function(){ cp.textContent = '✓ コピーしました'; setTimeout(function(){ cp.textContent = '🔗 リンクをコピー'; }, 1800); };
+      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(TEXT + ' ' + u).then(done, function(){ window.prompt('このリンクをコピーしてください', u); });
+      else window.prompt('このリンクをコピーしてください', u);
+    };
