+<!doctype html>
+<html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex">
+<title>毎朝のメール見本｜私だけの開運予報</title>
+<!-- LP（index.html）の「こんな“お手紙”が、毎朝届きます」に埋め込む見本。
+     実際に届くメールと同じひな形（mail-template/render-daily-mail.js）で、今月（JST）のメールを見本の会員で作って表示する。
+     ?m=1〜12 で月を指定できる。 -->
+<script src="bazi.js"></script>
+<script src="engine.js"></script>
+<script src="daily-engine.js"></script>
+<script src="jp-holidays.js"></script>
+<script src="mail-template/render-daily-mail.js"></script>
+<script src="jp-wrap.js" defer></script>
+</head><body style="margin:0;background:#f6eee9;">
+<script>
+(function(){
+  var now=new Date(Date.now()+9*3600e3), Y=now.getUTCFullYear(), M=now.getUTCMonth()+1, D=now.getUTCDate();
+  var q=location.search.match(/[?&]m=(\d{1,2})/); if(q&&+q[1]>=1&&+q[1]<=12){ if(+q[1]!==M){ M=+q[1]; D=8; } }
+  var r=KDaily.generateDaily({y:1995,m:9,d:12},{y:Y,m:M,d:D},{nick:'あかり',rel:'crush',sex:'f',timeUnknown:true,interests:['恋愛'],personBazi:window.PersonBazi});
+  var html=UnkiMail.renderDailyMail(r,{preview:true,assetBase:'',unsubscribeUrl:'#',mypageUrl:'#',operatorUrl:'tokushoho.html'}).html;
+  var body=html.slice(html.indexOf('<body'),html.lastIndexOf('</body>')); body=body.slice(body.indexOf('>')+1);
+  document.write(body.replace('padding:22px 10px 40px;','padding:0;'));
+  // 見本なので、リンクは押しても移動しない（相性診断だけは本物へ）
+  [].forEach.call(document.querySelectorAll('a'),function(a){ if(!a.hasAttribute('data-aishou')) a.addEventListener('click',function(e){e.preventDefault();}); else a.target='_top'; });
+})();
+/* 別サイト（1.66 166unmei.com）に埋め込んだときも高さがぴったり合うように、親ページへ高さを知らせる */
+(function(){function ph(){try{if(parent!==window)parent.postMessage({type:'unkiMailHeight',h:document.body.scrollHeight},'*');}catch(e){}}
+window.addEventListener('load',ph);window.addEventListener('resize',ph);setTimeout(ph,800);setTimeout(ph,2000);})();
+</script>
+</body></html>
