# Copy to .env and fill in. Never commit .env.

# Where THIS API is reachable (used to build confirm/unsubscribe links)
BASE_URL=https://letters.numinous.app
# The app/LP origin (calendar upsell link + CORS allow-origin)
APP_URL=https://numinous.app
PORT=8080

# Sender identity
FROM_NAME=Numinous
FROM_EMAIL=letters@numinous.app
ORG_NAME=72k Inc.
# CAN-SPAM: a REAL, valid physical postal address is legally required in every email.
# 番地・建物名まで書くのが望ましい（8-chome の後に番地を追記してください）
ORG_ADDRESS=72k Inc., Akasaka 8-chome, Minato-ku, Tokyo, Japan

# Email provider: postmark (default) | console (prints instead of sending — for dev)
MAIL_PROVIDER=postmark
POSTMARK_TOKEN=
POSTMARK_STREAM=broadcast

# Chart engine at signup: full (founder's real engine via headless Chromium,
# exact strength/用神/month pillar — DEFAULT) or heuristic (bazi.js only).
CHART_ENGINE=full
# Only if Playwright can't auto-find Chromium: absolute path to the browser.
PLAYWRIGHT_CHROMIUM=

# Storage (SQLite file). Point at a durable volume in production.
DB_PATH=./clarity.db

# Ops
SEND_CONCURRENCY=20
# Shared secret required on POST /internal/send-due (set the same on your cron caller)
CRON_SECRET=

# Optional LLM 'coach polish' — rephrases the engine's computed facts into
# warmer coaching prose (never invents facts). OFF unless BOTH are set.
# Costs money per unique situation/day (cached), so start with it off.
LETTER_AI=0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# In-app reading fair-use caps, per client per day (Four Pillars + I Ching +
# advisor chat combined). Founder-set: trial 5 / paid 30. The proxy applies
# the trial cap until resolvePlan() is wired to real entitlements (ai-proxy.js).
READING_DAILY_CAP_TRIAL=5
READING_DAILY_CAP_PRO=30

# Ads (future). 1 = render the sponsor slot; edit src/ads.js for inventory.
ADS_ENABLED=0
