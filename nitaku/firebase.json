{
  "hosting": {
    "target": "honbare",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "functions/**",
      "netlify.toml",
      "package.json",
      "*-src.html",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      { "source": "**/*.@(html|js)", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
      { "source": "**/*.@(png|webmanifest)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400" } ] }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
