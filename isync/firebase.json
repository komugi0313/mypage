{
  "hosting": {
    "target": "isync",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "*-src.html",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      { "source": "**/*.@(html|js)", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
      { "source": "/", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
      { "source": "**/", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
      { "source": "**/*.@(png|webmanifest)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400" } ] }
    ]
  }
}
