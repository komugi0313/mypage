// アイ・シンク（isync/）が使う Firestore の決まり。置き場所は isync_rooms（みんなのスマホで遊ぶ部屋）だけ。
// ★ このプロジェクト（typeplus-69c66）には、究極の二択（nitaku_）・ワンソナの決まりがすでにあります。
//   全部を置きかえると、ほかのサイトが動かなくなります。
//   Firebase の画面「Firestore Database → ルール」で、いまの決まりの
//   「match /databases/{database}/documents {」のすぐ下に、下の match /isync_rooms/... のかたまりだけを足してください。
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== ここから足す =====
    // みんなのスマホで遊ぶ部屋（4けたの部屋番号。12時間で消す＝expireAt に TTL を設定）
    match /isync_rooms/{code} {
      allow read: if code.matches('^[0-9]{4}$');
      allow create, update: if code.matches('^[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['created','round','phase','qi','qs','len','topic','anon','expireAt'])
        && request.resource.data.qs is list && request.resource.data.qs.size() <= 30
        && request.resource.data.phase in ['lobby','play','result'];
      allow delete: if false;

      // 部屋に入った人（ニックネームと答えだけ）
      match /players/{pid} {
        allow read: if code.matches('^[0-9]{4}$');
        allow create, update: if pid.size() <= 64
          && request.resource.data.keys().hasOnly(['name','ans','round','joined','ready','expireAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 20
          && request.resource.data.ans is map && request.resource.data.ans.size() <= 30;
        allow delete: if true;
      }
    }
    // ===== ここまで =====
  }
}
