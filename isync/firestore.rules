// アイ・シンク（isync/）が使う Firestore の決まり。置き場所は isync_rooms（みんなのスマホで遊ぶ部屋）と isync_votes（みんなの答えの数）だけ。
// ★ このプロジェクト（typeplus-69c66）には、究極の二択（nitaku_）・ワンソナの決まりがすでにあります。
//   全部を置きかえると、ほかのサイトが動かなくなります。
//   Firebase の画面「Firestore Database → ルール」で、いまの決まりの
//   「match /databases/{database}/documents {」のすぐ下に、下の match /isync_rooms/... のかたまりだけを足してください。
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== ここから足す =====
    // みんなのスマホで遊ぶ部屋（4けたの部屋番号。12時間で消す＝expireAt に TTL を設定）
    match /isync_rooms/{code} {
      allow read: if code.matches('^[0-9]{4}$');
      allow create, update: if code.matches('^[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['created','round','phase','qi','qs','len','topic','anon','kind','host','expireAt'])
        && request.resource.data.qs is list && request.resource.data.qs.size() <= 30
        && request.resource.data.phase in ['lobby','play','result'];
      allow delete: if false;

      // 部屋に入った人（ニックネームと答え。婚活・街コンの部屋では、番号・性別・合う人に出してほしい人・名前を見せてもいい相手・見せる名前）
      match /players/{pid} {
        allow read: if code.matches('^[0-9]{4}$');
        allow create, update: if pid.size() <= 64
          && request.resource.data.keys().hasOnly(['name','ans','round','joined','ready','no','sex','want','reveal','rname','expireAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 20
          && request.resource.data.ans is map && request.resource.data.ans.size() <= 30
          && (!('no' in request.resource.data) || (request.resource.data.no is string && request.resource.data.no.size() <= 3))
          && (!('sex' in request.resource.data) || request.resource.data.sex in ['m','f','x'])
          && (!('want' in request.resource.data) || request.resource.data.want in ['m','f','a'])
          && (!('reveal' in request.resource.data) || (request.resource.data.reveal is map && request.resource.data.reveal.size() <= 40))
          && (!('rname' in request.resource.data) || (request.resource.data.rname is string && request.resource.data.rname.size() <= 20));
        allow delete: if true;
      }
    }
    // みんなの答え（問題ごとに、答えA＝a・答えB＝b・3つ目＝c の数だけ。1回に1つずつしか増やせない・減らせない・消せない。名前は入れない）
    match /isync_votes/{qid} {
      function cnt(d, k) { return d.get(k, 0); }
      function total(d) { return cnt(d, 'a') + cnt(d, 'b') + cnt(d, 'c'); }
      allow read: if qid.matches('^q[0-9a-z]{1,8}$');
      allow create: if qid.matches('^q[0-9a-z]{1,8}$')
        && request.resource.data.keys().hasOnly(['a','b','c'])
        && total(request.resource.data) == 1
        && cnt(request.resource.data, 'a') >= 0 && cnt(request.resource.data, 'b') >= 0 && cnt(request.resource.data, 'c') >= 0;
      allow update: if request.resource.data.keys().hasOnly(['a','b','c'])
        && total(request.resource.data) == total(resource.data) + 1
        && cnt(request.resource.data, 'a') >= cnt(resource.data, 'a')
        && cnt(request.resource.data, 'b') >= cnt(resource.data, 'b')
        && cnt(request.resource.data, 'c') >= cnt(resource.data, 'c');
      allow delete: if false;
    }
    // ===== ここまで =====
  }
}
